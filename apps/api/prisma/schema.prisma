generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  BLOCKED
}
enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}
enum ProposalStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
enum TransactionType {
  INCOME
  EXPENSE
}
enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
}
enum OrderStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  taxId     String?  @map("tax_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  members   Membership[]
  units     Unit[]
  clients   Client[]
  regions   Region[]
  posts     FeedPost[]
  notifications Notification[]
  events    CalendarEvent[]
  proposals Proposal[]
  entries   FinancialEntry[]
  orders    Order[]
  exchanges Exchange[]
  storeCredits StoreCredit[]
  products  Product[]
  stockMovements StockMovement[]
  conversations Conversation[]
  auditLogs AuditLog[]
  invitations Invitation[]
  @@map("companies")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String       @map("password_hash")
  status       UserStatus   @default(INVITED)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  memberships  Membership[]
  sentMessages Message[]    @relation("MessageSender")
  authoredPosts FeedPost[]  @relation("FeedPostAuthor")
  auditLogs    AuditLog[]
  @@map("users")
}

model Membership {
  id        String     @id @default(uuid()) @db.Uuid
  companyId String     @db.Uuid @map("company_id")
  userId    String     @db.Uuid @map("user_id")
  role      MemberRole @default(MEMBER)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([companyId, userId])
  @@index([userId, active])
  @@index([companyId, unitId, regionId])
  managedRegions Region[] @relation("RegionManager")
  permissions ModulePermission[]
  assignedEvents CalendarEvent[]
  salesOrders Order[] @relation("OrderSeller")
  unitId String? @db.Uuid @map("unit_id")
  regionId String? @db.Uuid @map("region_id")
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  feedComments FeedComment[]
  feedReactions FeedReaction[]
  conversationMembers ConversationMember[]
  messageReads MessageRead[]
  notifications Notification[]
  @@map("memberships")
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  posts     FeedPost[]
  salesOrders Order[]
  financialEntries FinancialEntry[]
  regionId String? @db.Uuid @map("region_id")
  region Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  members Membership[]
  @@index([companyId, regionId])
  @@unique([companyId, name])
  @@map("units")
}

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid @map("company_id")
  name      String
  email     String?
  phone     String?
  document  String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proposals Proposal[]
  events    CalendarEvent[]
  orders    Order[]
  @@index([companyId, name])
  @@map("clients")
}

model Region {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid @map("company_id")
  name      String
  managerId String?  @db.Uuid @map("manager_id")
  managerMembershipId String? @db.Uuid @map("manager_membership_id")
  managerMembership Membership? @relation("RegionManager", fields: [managerMembershipId], references: [id], onDelete: SetNull)
  units Unit[]
  members Membership[]
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goals     RegionGoal[]
  @@unique([companyId, name])
  @@map("regions")
}

model RegionGoal {
  id        String   @id @default(uuid()) @db.Uuid
  regionId  String   @db.Uuid @map("region_id")
  title     String
  target    Decimal  @db.Decimal(14, 2)
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  @@map("region_goals")
}

model FeedPost {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid @map("company_id")
  authorId  String   @db.Uuid @map("author_id")
  content   String
  mediaUrl  String?  @map("media_url")
  announcement Boolean @default(false)
  unitId    String?  @db.Uuid @map("unit_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author    User     @relation("FeedPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  comments  FeedComment[]
  reactions FeedReaction[]
  @@index([companyId, createdAt])
  @@index([companyId, announcement, createdAt])
  @@map("feed_posts")
}

model CalendarEvent {
  id          String            @id @default(uuid()) @db.Uuid
  companyId   String            @db.Uuid @map("company_id")
  clientId    String?           @db.Uuid @map("client_id")
  assignedMembershipId String? @db.Uuid @map("assigned_membership_id")
  title       String
  description String?
  startsAt    DateTime          @map("starts_at")
  endsAt      DateTime          @map("ends_at")
  status      AppointmentStatus @default(PENDING)
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedMembership Membership? @relation(fields: [assignedMembershipId], references: [id], onDelete: SetNull)
  @@index([companyId, startsAt])
  @@index([companyId, assignedMembershipId, startsAt])
  @@map("calendar_events")
}

model Proposal {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @db.Uuid @map("company_id")
  clientId  String         @db.Uuid @map("client_id")
  number    String
  status    ProposalStatus @default(DRAFT)
  total     Decimal        @db.Decimal(14, 2) @default(0)
  validUntil DateTime?     @map("valid_until")
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client         @relation(fields: [clientId], references: [id])
  items     ProposalItem[]
  @@unique([companyId, number])
  @@map("proposals")
}

model ProposalItem {
  id          String   @id @default(uuid()) @db.Uuid
  proposalId  String   @db.Uuid @map("proposal_id")
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(14, 2) @map("unit_price")
  total       Decimal  @db.Decimal(14, 2)
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@map("proposal_items")
}

model FinancialEntry {
  id          String            @id @default(uuid()) @db.Uuid
  companyId   String            @db.Uuid @map("company_id")
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  description String
  amount      Decimal           @db.Decimal(14, 2)
  dueAt       DateTime          @map("due_at")
  paidAt      DateTime?         @map("paid_at")
  category    String?
  paymentMethod String?         @map("payment_method")
  reference   String?
  notes       String?
  orderId     String?           @unique @db.Uuid @map("order_id")
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  unitId      String?           @db.Uuid @map("unit_id")
  unit        Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId, dueAt, status])
  @@index([companyId, unitId, dueAt])
  @@index([companyId, paidAt])
  @@map("financial_entries")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid @map("company_id")
  name      String
  sku       String?
  price     Decimal  @db.Decimal(14, 2)
  stock     Decimal  @default(0) @db.Decimal(14, 3)
  minStock  Decimal  @default(0) @db.Decimal(14, 3) @map("min_stock")
  active    Boolean  @default(true)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  stockMovements StockMovement[]
  exchangeReturns ExchangeItem[] @relation("ReturnedProduct")
  exchangeReplacements ExchangeItem[] @relation("ReplacementProduct")
  @@unique([companyId, sku])
  @@map("products")
}

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @db.Uuid @map("company_id")
  clientId  String?     @db.Uuid @map("client_id")
  sellerMembershipId String? @db.Uuid @map("seller_membership_id")
  unitId String? @db.Uuid @map("unit_id")
  sellerMembership Membership? @relation("OrderSeller", fields: [sellerMembershipId], references: [id], onDelete: SetNull)
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  status    OrderStatus @default(OPEN)
  total     Decimal     @db.Decimal(14, 2) @default(0)
  openedAt  DateTime    @default(now()) @map("opened_at")
  closedAt  DateTime?   @map("closed_at")
  paymentMethod String? @map("payment_method")
  notes     String?
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  financialEntry FinancialEntry?
  stockMovements StockMovement[]
  exchanges Exchange[]
  storeCredits StoreCredit[]
  @@index([companyId, status, openedAt])
  @@index([companyId, closedAt, sellerMembershipId])
  @@index([companyId, closedAt, unitId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid @map("order_id")
  productId String  @db.Uuid @map("product_id")
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(14, 2) @map("unit_price")
  total     Decimal @db.Decimal(14, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  @@map("order_items")
}

model StockMovement {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid @map("company_id")
  productId String   @db.Uuid @map("product_id")
  orderId   String?  @db.Uuid @map("order_id")
  type      String
  quantity  Decimal  @db.Decimal(14, 3)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  @@index([companyId, productId, createdAt])
  @@map("stock_movements")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid @map("company_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages  Message[]
  members   ConversationMember[]
  @@index([companyId, createdAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid @map("conversation_id")
  senderId       String       @db.Uuid @map("sender_id")
  body           String
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  reads          MessageRead[]
  @@index([conversationId, createdAt])
  @@map("messages")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid @map("company_id")
  userId    String?  @db.Uuid @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([companyId, createdAt])
  @@map("audit_logs")
}



enum ExchangeStatus {
  COMPLETED
  CANCELLED
}

model Exchange {
  id          String @id @default(uuid()) @db.Uuid
  companyId   String @db.Uuid @map("company_id")
  orderId     String @db.Uuid @map("order_id")
  performedBy String @db.Uuid @map("performed_by")
  reason      String
  status      ExchangeStatus @default(COMPLETED)
  returnedValue Decimal @db.Decimal(14,2) @map("returned_value")
  replacementValue Decimal @db.Decimal(14,2) @map("replacement_value")
  difference  Decimal @db.Decimal(14,2)
  settlement  String
  paymentMethod String? @map("payment_method")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  company     Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  order       Order @relation(fields:[orderId], references:[id], onDelete:Restrict)
  items       ExchangeItem[]
  storeCredit StoreCredit?
  @@index([companyId, createdAt])
  @@index([companyId, orderId])
  @@map("exchanges")
}

model ExchangeItem {
  id String @id @default(uuid()) @db.Uuid
  exchangeId String @db.Uuid @map("exchange_id")
  orderItemId String @db.Uuid @map("order_item_id")
  returnedProductId String @db.Uuid @map("returned_product_id")
  replacementProductId String? @db.Uuid @map("replacement_product_id")
  returnedQuantity Decimal @db.Decimal(12,3) @map("returned_quantity")
  replacementQuantity Decimal @default(0) @db.Decimal(12,3) @map("replacement_quantity")
  returnedUnitValue Decimal @db.Decimal(14,2) @map("returned_unit_value")
  replacementUnitValue Decimal? @db.Decimal(14,2) @map("replacement_unit_value")
  condition String
  exchange Exchange @relation(fields:[exchangeId], references:[id], onDelete:Cascade)
  orderItem OrderItem @relation(fields:[orderItemId], references:[id], onDelete:Restrict)
  returnedProduct Product @relation("ReturnedProduct", fields:[returnedProductId], references:[id], onDelete:Restrict)
  replacementProduct Product? @relation("ReplacementProduct", fields:[replacementProductId], references:[id], onDelete:Restrict)
  @@map("exchange_items")
}


model StoreCredit {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid @map("company_id")
  orderId String @db.Uuid @map("order_id")
  exchangeId String @unique @db.Uuid @map("exchange_id")
  amount Decimal @db.Decimal(14,2)
  balance Decimal @db.Decimal(14,2)
  status String @default("AVAILABLE")
  createdAt DateTime @default(now()) @map("created_at")
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
  exchange Exchange @relation(fields:[exchangeId],references:[id],onDelete:Restrict)
  @@index([companyId,status,createdAt])
  @@map("store_credits")
}

model Invitation {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid @map("company_id")
  email     String
  name      String
  role      MemberRole @default(MEMBER)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt DateTime @default(now()) @map("created_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId, email])
  @@map("invitations")
}

model ModulePermission {
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @db.Uuid @map("membership_id")
  module       String
  canView      Boolean @default(false) @map("can_view")
  canCreate    Boolean @default(false) @map("can_create")
  canEdit      Boolean @default(false) @map("can_edit")
  canDelete    Boolean @default(false) @map("can_delete")
  membership  Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  @@unique([membershipId, module])
  @@map("module_permissions")
}


model FeedComment {
  id           String @id @default(uuid()) @db.Uuid
  postId       String @db.Uuid @map("post_id")
  membershipId String @db.Uuid @map("membership_id")
  body         String
  createdAt    DateTime @default(now()) @map("created_at")
  post         FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  @@index([postId, createdAt])
  @@map("feed_comments")
}

model FeedReaction {
  id           String @id @default(uuid()) @db.Uuid
  postId       String @db.Uuid @map("post_id")
  membershipId String @db.Uuid @map("membership_id")
  createdAt    DateTime @default(now()) @map("created_at")
  post         FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  @@unique([postId, membershipId])
  @@index([postId])
  @@map("feed_reactions")
}

model ConversationMember {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid @map("conversation_id")
  membershipId   String @db.Uuid @map("membership_id")
  joinedAt       DateTime @default(now()) @map("joined_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  membership    Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  @@unique([conversationId, membershipId])
  @@index([membershipId])
  @@map("conversation_members")
}

model MessageRead {
  id           String @id @default(uuid()) @db.Uuid
  messageId    String @db.Uuid @map("message_id")
  membershipId String @db.Uuid @map("membership_id")
  readAt       DateTime @default(now()) @map("read_at")
  message      Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  @@unique([messageId, membershipId])
  @@index([membershipId, readAt])
  @@map("message_reads")
}

model Notification {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @db.Uuid @map("company_id")
  membershipId String @db.Uuid @map("membership_id")
  type         String
  title        String
  body         String
  resourceType String? @map("resource_type")
  resourceId   String? @db.Uuid @map("resource_id")
  readAt       DateTime? @map("read_at")
  createdAt    DateTime @default(now()) @map("created_at")
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  @@index([membershipId, readAt, createdAt])
  @@index([companyId, createdAt])
  @@map("notifications")
}
